{
  "name": "jetlag-praha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:default-area": "tsx scripts/prepare-default-game-area.ts",
    "data:prepare": "tsx scripts/prepare-administrative.ts",
    "data:check": "tsx scripts/check-administrative.ts",
    "data:bundle": "npm run data:prepare -- --input data/raw/mestskecasti.geojson --metadata data/source-metadata/municipal.json --code-field kod_mc --name-field nazev_mc && npm run data:prepare -- --input data/raw/katastralni-uzemi-praha.geojson --metadata data/source-metadata/cadastral.json --code-field kod_ku --name-field naz_ku --filter-field kod_obec --filter-value 554782",
    "pid:inspect": "tsx scripts/inspect-pid.ts",
    "pid:download": "tsx scripts/download-pid.ts",
    "pid:bundle": "tsx scripts/prepare-pid.ts",
    "pid:publish": "tsx scripts/refresh-pid-gtfs.ts",
    "pid:legacy:publish": "tsx scripts/refresh-pid-publication.ts",
    "pid:check": "tsx scripts/check-pid.ts",
    "pid:gtfs": "tsx scripts/refresh-pid-gtfs.ts",
    "pid:stage": "tsx scripts/stage-pid-publication.ts",
    "poi:publish": "tsx scripts/publish-poi.ts"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "2.20.2",
    "@turf/turf": "^7.3.0",
    "@zip.js/zip.js": "2.24.0",
    "csv-parse": "6.1.0",
    "jsts": "2.12.1",
    "leaflet": "1.9.4",
    "proj4": "2.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shpjs": "6.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/shpjs": "3.4.7",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fflate": "^0.8.3",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
