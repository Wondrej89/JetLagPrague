# Klientský klíč Mapy.com s omezením HTTP refereru a služeb (pouze maptiles).
# Není součástí exportovaných herních dat. Ve výsledném JS je veřejně viditelný.
VITE_MAPY_API_KEY=

# Veřejná HTTPS adresa nakonfigurovaného Cloudflare Workeru (žádný secret).
# Bez ní zůstává serverové publikování vypnuté.
VITE_PUBLISHER_URL=
